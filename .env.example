# ---------------------------------------------------------------------------
# DealBuddy AI — environment variables
# Copy to .env.local for local development. On Vercel, add these in
# Project → Settings → Environment Variables.
# Never put private keys in NEXT_PUBLIC_ variables — those are sent to browsers.
# ---------------------------------------------------------------------------

# --- Anthropic (Claude) — required for live AI. Without it the app runs in demo mode.
ANTHROPIC_API_KEY=
# Any current Claude model ID from https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: model used for Creator Pro "priority" generations (defaults to ANTHROPIC_MODEL)
ANTHROPIC_MODEL_PRO=

# --- Supabase — required for accounts, usage limits and saved results
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay — optional. Paid plans stay disabled until ALL five are set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_PLUS=
RAZORPAY_PLAN_ID_PRO=

# --- App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional tuning
# Monthly generation allowances (set the NEXT_PUBLIC_ twins too so the pricing page matches)
PLAN_PLUS_MONTHLY_LIMIT=60
PLAN_PRO_MONTHLY_LIMIT=200
NEXT_PUBLIC_PLAN_PLUS_MONTHLY_LIMIT=60
NEXT_PUBLIC_PLAN_PRO_MONTHLY_LIMIT=200
# Burst rate limits per minute
RATE_LIMIT_IP_PER_MIN=20
RATE_LIMIT_USER_PER_MIN=8
RATE_LIMIT_PRIORITY_USER_PER_MIN=20
# Local preview only (no Supabase, not production): generations allowed per IP
LOCAL_PREVIEW_LIMIT=3
